{
  "name": "@retro/workspace",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:web": "pnpm --filter @retro/web dev",
    "dev:admin": "pnpm --filter @retro/admin dev",
    "dev:desktop": "pnpm --filter @retro/desktop dev",
    "dev:mobile": "pnpm --filter @retro/mobile start",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "turbo run lint"
  },
  "devDependencies": {
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "eslint": "10.8.0",
    "prettier": "3.4.2"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1.1.16": "1.1.17"
    }
  }
}
