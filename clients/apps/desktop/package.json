{
  "name": "@retro/desktop",
  "version": "0.1.0",
  "description": "Ứng dụng chat Retro Messenger dành cho Windows.",
  "author": "Retro Messenger Contributors",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.mjs",
    "test:electron": "electron test/electron-renderer-smoke.mjs",
    "lint": "echo desktop:lint",
    "icon:generate": "node scripts/generate-icon.mjs",
    "package:win": "pnpm icon:generate && pnpm build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "@retro/api-client": "workspace:*",
    "@retro/contracts": "workspace:*",
    "@retro/realtime-client": "workspace:*",
    "electron-updater": "6.8.9",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "@vitejs/plugin-react": "4.3.4",
    "electron": "43.2.0",
    "electron-vite": "5.0.0",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "typescript": "5.7.2"
  },
  "build": {
    "appId": "com.retromessenger.desktop",
    "productName": "Retro Messenger",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Retro-Messenger-${version}-${arch}.${ext}",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "local",
      "repo": "retro-messenger",
      "releaseType": "release"
    }
  }
}
